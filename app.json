{
  "expo": {
    "name": "TELAFIT",
    "slug": "telafit",
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "O app precisa de acesso às suas fotos para salvá-las na galeria.",
          "savePhotosPermission": "O app precisa de permissão para salvar fotos na sua galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa de acesso às suas fotos para redimensionar em lote."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "386990c8-fa37-4881-a9c3-22fd3a829f5a"
      }
    },
    "android": {
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.felipegia.telafit"
    }
  }
}